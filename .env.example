# ---- what the app uses (edit these) ----
STORE=tigergraph                 # tigergraph = the cloud graph database
DATASET_DIR=data/slim            # data/slim = the real data
RAG=1                            # 1 = look up similar past cases and policy text by meaning (needs Ollama + EMBED_MODEL)
PORT=4000

# ---- the AI model that writes the text (through Ollama; the app never writes text without it) ----
LLM_MODEL_OLLAMA=gemma4:31b-cloud   # gemma4:31b-cloud (free cloud) | glm-5.3:cloud (needs paid Ollama credits) | qwen2.5-coder:7b (local, slow)
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
LLM_TIMEOUT_S=120                # seconds to wait for the model per try; after 3 failed tries the case stops with an error

# ---- TigerGraph Savanna (cloud; the local Docker option was dropped as too heavy) ----
# Find the host in Savanna: workspace > Connect > Admin Portal; the URL's `domain=` value plus `.tgcloud.io`.
TG_HOST=https://<workspace-domain>.i.tgcloud.io
TG_RESTPP_PORT=443
TG_GS_PORT=443
TG_GRAPH=FraudGraph
TG_GRAPH_TEST=FraudTest
# Credentials: fill ONE. Never commit them.
TG_SECRET=            # Savanna > Database Secrets (exchanged for a token)
TG_API_TOKEN=
TG_USERNAME=
TG_PASSWORD=
