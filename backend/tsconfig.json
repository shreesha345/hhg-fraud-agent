{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "noUncheckedIndexedAccess": false, "forceConsistentCasingInFileNames": true,
    "isolatedModules": true, "types": ["node"]
  },
  "include": ["src", "tests"]
}
