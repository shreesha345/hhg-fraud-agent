CREATE GRAPH @G@ ()
USE GRAPH @G@
CREATE SCHEMA_CHANGE JOB @G@_schema FOR GRAPH @G@ {
  ADD VERTEX Customer(PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX BankCard(PRIMARY_ID id STRING, customer STRING, network STRING, ctype STRING, label STRING, label_derived BOOL) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Transaction(PRIMARY_ID id STRING, ts INT, amt DOUBLE, prod STRING, channel STRING, score DOUBLE, region INT) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX DeviceProfile(PRIMARY_ID id STRING, family STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX BillingRegion(PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX EmailDomain(PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Pattern(PRIMARY_ID id STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX ClosedCase(PRIMARY_ID id STRING, customer STRING, card_label STRING, outcome STRING, pattern STRING, opened_ts INT, closed_ts INT, exposure DOUBLE, notes STRING, report_filed BOOL, actions STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX FraudCase(PRIMARY_ID id STRING, case_id STRING, status STRING, verdict STRING, probability DOUBLE, pattern STRING, exposure DOUBLE, summary STRING, opened_ts INT) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Evidence(PRIMARY_ID id STRING, claim STRING, source STRING, ref STRING, klass STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX Action(PRIMARY_ID id STRING, action STRING, route STRING, stage STRING, reason STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";
  ADD VERTEX PolicyChunk(PRIMARY_ID id STRING, title STRING, doc STRING, text STRING) WITH PRIMARY_ID_AS_ATTRIBUTE="true";

  ADD DIRECTED EDGE OWNS(FROM Customer, TO BankCard) WITH REVERSE_EDGE="OWNED_BY";
  ADD DIRECTED EDGE MADE(FROM BankCard, TO Transaction, ts INT) WITH REVERSE_EDGE="MADE_BY";
  ADD DIRECTED EDGE NEXT(FROM Transaction, TO Transaction) WITH REVERSE_EDGE="PREV";
  ADD DIRECTED EDGE FROM_DEVICE(FROM Transaction, TO DeviceProfile, ts INT, is_new BOOL, proxy_kind STRING) WITH REVERSE_EDGE="DEVICE_OF";
  ADD DIRECTED EDGE BILLED_IN(FROM Transaction, TO BillingRegion, ts INT) WITH REVERSE_EDGE="REGION_OF";
  ADD DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction, TO EmailDomain, ts INT) WITH REVERSE_EDGE="EMAIL_OF";
  ADD DIRECTED EDGE CLOSED_INVOLVES(FROM ClosedCase, TO Transaction, seq INT) WITH REVERSE_EDGE="IN_CLOSED_CASE";
  ADD DIRECTED EDGE CLOSED_ON_CARD(FROM ClosedCase, TO BankCard) WITH REVERSE_EDGE="CARD_HAS_CLOSED";
  ADD DIRECTED EDGE CLOSED_CONNECTED(FROM ClosedCase, TO BankCard) WITH REVERSE_EDGE="CARD_CONNECTED_IN";
  ADD DIRECTED EDGE CLOSED_MATCHES(FROM ClosedCase, TO Pattern) WITH REVERSE_EDGE="PATTERN_OF_CLOSED";
  ADD DIRECTED EDGE INVOLVES(FROM FraudCase, TO Transaction) WITH REVERSE_EDGE="IN_CASE";
  ADD DIRECTED EDGE CASE_ON_CARD(FROM FraudCase, TO BankCard) WITH REVERSE_EDGE="CARD_IN_CASE";
  ADD DIRECTED EDGE CASE_CONNECTED_TO(FROM FraudCase, TO BankCard) WITH REVERSE_EDGE="CARD_CONNECTED_IN_CASE";
  ADD DIRECTED EDGE CASE_SUSPECTS(FROM FraudCase, TO DeviceProfile) WITH REVERSE_EDGE="SUSPECTED_IN";
  ADD DIRECTED EDGE CASE_MATCHES(FROM FraudCase, TO Pattern) WITH REVERSE_EDGE="PATTERN_OF_CASE";
  ADD DIRECTED EDGE RETRIEVED(FROM FraudCase, TO ClosedCase) WITH REVERSE_EDGE="RETRIEVED_BY";
  ADD DIRECTED EDGE HAS_EVIDENCE(FROM FraudCase, TO Evidence) WITH REVERSE_EDGE="EVIDENCE_OF";
  ADD DIRECTED EDGE CITES(FROM Evidence, TO Transaction) WITH REVERSE_EDGE="CITED_BY";
  ADD DIRECTED EDGE RECOMMENDS(FROM FraudCase, TO Action) WITH REVERSE_EDGE="RECOMMENDED_IN";
  ADD DIRECTED EDGE DESCRIBES_PATTERN(FROM PolicyChunk, TO Pattern) WITH REVERSE_EDGE="PATTERN_DESCRIBED_BY";
}
RUN SCHEMA_CHANGE JOB @G@_schema
