{
  "name": "fraud-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "node scripts/make-audio.mjs",
    "capture:terminal": "node scripts/capture-terminal.mjs",
    "capture:browser": "node scripts/capture-browser.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Main out/fraud-investigator.mp4 --codec h264 --crf 20",
    "render:full": "remotion render src/index.ts Full out/fraud-investigator-full.mp4 --codec h264 --crf 20",
    "narration": "node scripts/ingest-narration.mjs",
    "srt": "npx tsx scripts/make-srt.ts",
    "tts": "node scripts/gemini-tts.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "remotion": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "puppeteer-core": "23.11.1",
    "typescript": "5.6.3"
  }
}
